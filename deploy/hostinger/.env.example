# Copy into protected server environment, never commit real values.
APP_ENV=development
NODE_ENV=development
APP_URL=http://localhost:3001
EMAIL_APP_URL=http://localhost:3001
PORT=3001
HOST=127.0.0.1
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=YOUR_DEVELOPMENT_DATABASE
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_CONNECTION_LIMIT=10
DB_SSL=false
AUTH_SESSION_SECRET=
# Preserve the existing encryption key when importing encrypted gateway profiles.
RAZORPAY_ENCRYPTION_KEY=
OWNER_EMAIL=
# Absolute private directory outside the deployed checkout, required in production.
PERSISTENT_STORAGE_DIR=
ALLOWED_ORIGINS=http://localhost:3001
PAYMENT_PUBLIC_ORIGIN=https://study.ayurvedasidhi.com
ALLOW_LIVE_PAYMENTS=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@ayurvedasidhi.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ayurvedasidhi.com
SMTP_FROM_NAME=Pratyaksh Ayurveda
# Optional Google web Client ID; no client secret needed for GIS ID-token sign-in.
GOOGLE_CLIENT_ID=
# Credentials normally imported encrypted and managed through Admin Gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Serve the verified imported catalogue; authorized upstream media may still be required.
PRATYAKSH_CONTENT_MODE=local
PRATYAKSH_CONTENT_SNAPSHOT_ON_AUTH_DENIAL=false
PRATYAKSH_CONTENT_API_BASE=https://portal.pratyakshayurveda.in/api/
PRATYAKSH_CONTENT_TOKEN=
PRATYAKSH_REMOTE_ADMIN_ENABLED=false
